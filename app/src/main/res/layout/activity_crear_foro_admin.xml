<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:fillViewport="true"
    android:padding="24dp"
    tools:context=".CrearForoAdmin">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear Foro por Grado"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/editTituloForo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título del foro"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textPrimary"
            android:backgroundTint="@color/textPrimary"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/editDescripcionForo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción del foro"
            android:textColor="@color/textPrimary"
            android:textColorHint="@color/textPrimary"
            android:backgroundTint="@color/textPrimary"
            android:minLines="3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccionar grado:"
            android:textColor="@color/textPrimary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinnerGradoForo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/textPrimary"
            android:padding="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jefe de grado:"
            android:textColor="@color/textPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvJefeGrado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de acudientes:"
            android:textColor="@color/textPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNumeroAcudientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/textPrimary"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnCrearForo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear Foro"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/accentOrange"
            android:elevation="4dp" />
    </LinearLayout>
</ScrollView>
