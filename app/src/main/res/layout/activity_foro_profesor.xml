<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"
    android:padding="16dp"
    tools:context=".ForoProfesor">

    <!-- Botón de volver -->
    <TextView
        android:id="@+id/tvVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Volver"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp"
        android:padding="4dp" />

    <!-- Título del foro -->
    <TextView
        android:id="@+id/tvTituloForo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Foro del Grado"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Lista de mensajes -->
    <ScrollView
        android:id="@+id/scrollMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/contenedorMensajes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- Campo de texto y botón de enviar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="8dp"
        android:elevation="6dp"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/editMensaje"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Escribir mensaje..."
            android:textColor="#000000"
            android:textColorHint="#555555"
            android:background="@drawable/bg_edittext_round"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnEnviar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_send_button"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:contentDescription="Enviar" />
    </LinearLayout>


</LinearLayout>
