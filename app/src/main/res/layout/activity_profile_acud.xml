<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_bg"
    android:fitsSystemWindows="true">

    <!-- CONTENIDO SCROLL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- 🔹 Avatar y datos básicos -->
            <ImageView
                android:id="@+id/ivAvatarAcud"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_person"
                android:background="@drawable/rounded_white_card"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:layout_marginTop="20dp"
                android:elevation="4dp"
                android:clipToOutline="true"/>

            <TextView
                android:id="@+id/tvNameAcud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Acudiente"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvEmailAcud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="acudiente@correo.com"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvRolAcud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Acudiente"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="@android:color/white"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="20dp"/>

            <!-- INFO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_white_card"
                android:elevation="4dp"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información del Acudiente"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvHijos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hijos asociados:"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp"/>
            </LinearLayout>

            <!-- OPCIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_white_card"
                android:elevation="4dp"
                android:padding="8dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/notas"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Ver rendimiento académico"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_notifications"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Notificaciones"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnEditAcud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editar perfil"
                android:backgroundTint="@color/accentOrange"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:elevation="3dp"/>

            <Button
                android:id="@+id/btnLogoutAcud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar sesión"
                android:backgroundTint="@color/errorRed"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:elevation="3dp"
                android:layout_marginBottom="30dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV CORRECTO -->
    <include
        layout="@layout/bottom_navigation_view"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@android:color/white"/>
</LinearLayout>

