<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_white_card"
    android:padding="12dp"
    android:layout_marginVertical="6dp">

    <ImageView
        android:id="@+id/ivEmisorAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/estrella"
        android:contentDescription="Avatar"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvEmisorNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nombre del Emisor"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toEndOf="@id/ivEmisorAvatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvHoraComunicado"
        android:layout_marginStart="12dp"/>

    <TextView
        android:id="@+id/tvHoraComunicado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:30 a. m."
        android:textColor="@android:color/darker_gray"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvEmisorNombre"/>

    <TextView
        android:id="@+id/tvComunicadoTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Título del comunicado"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@id/tvEmisorNombre"
        app:layout_constraintTop_toBottomOf="@id/tvEmisorNombre"
        app:layout_constraintEnd_toStartOf="@id/ivAccionSecundaria"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvComunicadoPreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Inicio del mensaje o descripción..."
        android:textColor="@android:color/darker_gray"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="@id/tvComunicadoTitulo"
        app:layout_constraintTop_toBottomOf="@id/tvComunicadoTitulo"
        app:layout_constraintEnd_toStartOf="@id/ivAccionSecundaria"
        android:maxLines="2"
        android:ellipsize="end"/>

    <ImageView
        android:id="@+id/ivAccionSecundaria"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/estrella"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
